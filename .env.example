# Copy this file to .env before you run the app for the first time:
#
#     cp .env.example .env
#
# .env is gitignored. It never goes in a commit — if you find yourself about to
# commit one, that is the moment to stop and ask.

# How many sessions the list shows before it stops. Vite only exposes variables
# that start with VITE_ to the browser, which is why the prefix is there.
VITE_PAGE_SIZE=20
